# Required: Anthropic API key for Claude spec generation
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: webhook URL for email captures (e.g. ConvertKit, Resend, Zapier)
# If unset, emails just log to the server console.
SUBSCRIBE_WEBHOOK_URL=
